{
  "type": "combat-behavior",
  "id": "phase_watcher",
  "name": "Change stance when wounded",
  "fallback": "end-turn",
  "rules": [
    {
      "when": "self.hit_points * 2 > self.max_hit_points",
      "priority": "20",
      "commit": "step",
      "steps": [
        {
          "action": {
            "action": "three-action:creature_ranged",
            "name": "Shard ray",
            "to_hit": "9",
            "damage": "1d8 + 3",
            "deadly": "0",
            "map": "5",
            "slashing": "0",
            "range": "10"
          },
          "target": "enemy"
        }
      ],
      "fallback": "next"
    },
    {
      "when": "self.hit_points * 2 <= self.max_hit_points",
      "priority": "25",
      "commit": "plan",
      "steps": [
        {
          "destination": {
            "kind": "toward",
            "distance": "1"
          },
          "action": {
            "action": "three-action:stride"
          },
          "target": "enemy"
        },
        {
          "action": {
            "action": "three-action:creature_strike",
            "name": "Rift claw",
            "to_hit": "10",
            "damage": "1d10 + 4",
            "deadly": "1d8",
            "map": "5",
            "slashing": "1"
          },
          "target": "enemy"
        }
      ],
      "fallback": "end-turn"
    },
    {
      "when": "self.hit_points * 2 <= self.max_hit_points",
      "priority": "24",
      "steps": [
        {
          "action": {
            "action": "three-action:creature_strike",
            "name": "Rift claw",
            "to_hit": "10",
            "damage": "1d10 + 4",
            "deadly": "1d8",
            "map": "5",
            "slashing": "1"
          },
          "target": "enemy"
        }
      ],
      "fallback": "end-turn"
    }
  ]
}
