<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>RustyGoldbox.Game.RustyGoldboxProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-goldbox</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Goldbox</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/../ui</RustyEngineProductUiRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/../../content</RustyEngineProductContentRoot>
    <RustyEngineProductUiProjectionStream>rusty-goldbox</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty.goldbox.status</RustyEngineProductUiProjectionContract>
    <RustyEngineProductInputCursorMode>unlocked</RustyEngineProductInputCursorMode>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$(RustyEngineProductUiRoot);$(RustyEngineProductContentRoot)</RustyEngineWatchPaths>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEnginePackageVersion)]" />
  </ItemGroup>
</Project>
