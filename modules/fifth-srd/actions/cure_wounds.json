{
  "type": "action",
  "id": "cure_wounds",
  "name": "Cure Wounds",
  "cost": {
    "action": 1
  },
  "target": "hurt_ally",
  "range": "1",
  "score": "if target.hit_points * 2 < target.max_hit_points then 10 else -1",
  "always": [
    {
      "op": "heal",
      "amount": "2d8 + self.spell_mod + self.life_bonus"
    },
    {
      "op": "remove_condition",
      "condition": "dying"
    },
    {
      "op": "remove_condition",
      "condition": "stable"
    },
    {
      "op": "if",
      "when": "target.death_successes > 0",
      "then": [
        {
          "op": "damage",
          "track": "death_successes",
          "amount": "3"
        }
      ]
    },
    {
      "op": "if",
      "when": "target.death_failures > 0",
      "then": [
        {
          "op": "damage",
          "track": "death_failures",
          "amount": "3"
        }
      ]
    }
  ]
}
