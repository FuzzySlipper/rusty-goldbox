{
  "type": "event",
  "id": "evt_vil_optional_jack",
  "kind": "branch",
  "branches": [
    {
      "when": "area.var.blackapple_optional_jack_secret == 'consented_care'",
      "next": "evt_vil_optional_jack_revisit_care"
    },
    {
      "when": "area.var.blackapple_optional_jack_secret == 'consented_containment'",
      "next": "evt_vil_optional_jack_revisit_containment"
    },
    {
      "when": "area.var.blackapple_optional_jack_secret == 'declined'",
      "next": "evt_vil_optional_jack_revisit_declined"
    }
  ],
  "otherwise": "evt_vil_optional_jack_offer"
}
