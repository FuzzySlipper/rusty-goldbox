{
  "type": "event",
  "id": "evt_fin_child_giles_weadley",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.return_account_complete and campaign.var.child_giles_weadley != 'freed'",
      "next": "evt_fin_child_philip_anvil"
    },
    {
      "when": "campaign.var.child_giles_weadley == 'freed'",
      "next": "evt_fin_child_giles_weadley_freed"
    },
    {
      "when": "campaign.var.child_giles_weadley == 'returned'",
      "next": "evt_fin_child_giles_weadley_returned"
    },
    {
      "when": "campaign.var.child_giles_weadley == 'captive'",
      "next": "evt_fin_child_giles_weadley_captive"
    },
    {
      "when": "campaign.var.child_giles_weadley == 'unknown'",
      "next": "evt_fin_child_giles_weadley_unknown"
    }
  ],
  "otherwise": "evt_fin_child_giles_weadley_unknown"
}
