{
  "type": "event",
  "id": "evt_vil_optional_smithson",
  "kind": "branch",
  "branches": [
    {
      "when": "area.var.blackapple_optional_smithson_care == 'distance_warning'",
      "next": "evt_vil_optional_smithson_revisit_distance"
    },
    {
      "when": "area.var.blackapple_optional_smithson_care == 'care_referral'",
      "next": "evt_vil_optional_smithson_revisit_care"
    },
    {
      "when": "area.var.blackapple_optional_smithson_care == 'passed'",
      "next": "evt_vil_optional_smithson_revisit_passed"
    }
  ],
  "otherwise": "evt_vil_optional_smithson_offer"
}
