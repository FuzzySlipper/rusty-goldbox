{
  "type": "event",
  "id": "evt_fin_epilogue_public_gate",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.village_trust >= 2 and (campaign.var.figwort_stance == 'protect' or campaign.var.figwort_stance == 'reconcile')",
