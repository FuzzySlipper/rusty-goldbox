{
  "type": "event",
  "id": "evt_fin_child_bernard_goodall",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.return_account_complete and campaign.var.child_bernard_goodall != 'freed'",
      "next": "evt_fin_child_giles_weadley"
    },
    {
      "when": "campaign.var.child_bernard_goodall == 'freed'",
      "next": "evt_fin_child_bernard_goodall_freed"
    },
    {
      "when": "campaign.var.child_bernard_goodall == 'returned'",
      "next": "evt_fin_child_bernard_goodall_returned"
    },
    {
      "when": "campaign.var.child_bernard_goodall == 'captive'",
      "next": "evt_fin_child_bernard_goodall_captive"
    },
    {
      "when": "campaign.var.child_bernard_goodall == 'unknown'",
      "next": "evt_fin_child_bernard_goodall_unknown"
    }
  ],
  "otherwise": "evt_fin_child_bernard_goodall_unknown"
}
