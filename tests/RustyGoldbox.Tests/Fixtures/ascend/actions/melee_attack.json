{
  "type": "action",
  "id": "melee_attack",
  "name": "Melee attack",
  "cost": {
    "standard": 1
  },
  "target": "enemy",
  "range": "1",
  "parameters": [
    "damage"
  ],
  "check": "attack",
  "outcomes": {
    "success": [
      {
        "op": "damage",
        "amount": "use.damage + self.might_mod"
      }
    ],
    "critical": [
      {
        "op": "damage",
        "amount": "use.damage + use.damage + self.might_mod * 2"
      }
    ]
  },
  "prefer": "if target.condition.shaken then 100 - target.hit_points else 0 - target.hit_points"
}
