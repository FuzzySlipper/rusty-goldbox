{
  "type": "event",
  "id": "evt_fin_child_ursula_cooke",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.return_account_complete and campaign.var.child_ursula_cooke != 'freed'",
      "next": "evt_fin_child_stevie_leeford"
    },
    {
      "when": "campaign.var.child_ursula_cooke == 'freed'",
      "next": "evt_fin_child_ursula_cooke_freed"
    },
    {
      "when": "campaign.var.child_ursula_cooke == 'returned'",
      "next": "evt_fin_child_ursula_cooke_returned"
    },
    {
      "when": "campaign.var.child_ursula_cooke == 'captive'",
      "next": "evt_fin_child_ursula_cooke_captive"
    },
    {
      "when": "campaign.var.child_ursula_cooke == 'unknown'",
      "next": "evt_fin_child_ursula_cooke_unknown"
    }
  ],
  "otherwise": "evt_fin_child_ursula_cooke_unknown"
}
