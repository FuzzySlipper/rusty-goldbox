{
  "type": "event",
  "id": "evt_fin_child_stevie_leeford",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.child_stevie_leeford == 'freed'",
      "next": "evt_fin_child_stevie_leeford_freed"
    },
    {
      "when": "campaign.var.child_stevie_leeford == 'returned'",
      "next": "evt_fin_child_stevie_leeford_returned"
    },
    {
      "when": "campaign.var.child_stevie_leeford == 'captive'",
      "next": "evt_fin_child_stevie_leeford_captive"
    },
    {
      "when": "campaign.var.child_stevie_leeford == 'unknown'",
      "next": "evt_fin_child_stevie_leeford_unknown"
    }
  ],
  "otherwise": "evt_fin_child_stevie_leeford_unknown"
}
