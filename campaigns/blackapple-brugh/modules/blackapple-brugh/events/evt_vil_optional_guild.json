{
  "type": "event",
  "id": "evt_vil_optional_guild",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.forest_stance == 'respect'",
      "next": "evt_vil_optional_guild_revisit_respect"
    },
    {
      "when": "campaign.var.forest_stance == 'exploit'",
      "next": "evt_vil_optional_guild_revisit_exploit"
    }
  ],
  "otherwise": "evt_vil_optional_guild_offer"
}
