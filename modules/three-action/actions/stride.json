{
  "type": "action",
  "id": "stride",
  "name": "Stride",
  "cost": {
    "action": 1
  },
  "target": "enemy",
  "available": "not self.condition.prone",
  "valid_target": "combat.distance > self.engage_range or not combat.sight",
  "prefer": "0 - combat.distance",
  "score": "1",
  "always": [
    {
      "op": "move",
      "distance": "floor(self.speed / 5)",
      "within": "self.engage_range"
    }
  ]
}
