{
  "type": "event",
  "id": "evt_vil_sanitarium_investigate",
  "kind": "branch",
  "branches": [
    {
      "when": "campaign.var.double_arthur_figwort == 'exposed'",
      "next": "evt_vil_sanitarium_expose_revisit_text"
    },
    {
      "when": "campaign.var.double_arthur_figwort == 'contained'",
      "next": "evt_vil_sanitarium_contained_revisit_text"
    }
  ],
  "otherwise": "evt_vil_sanitarium_expose_stance"
}
