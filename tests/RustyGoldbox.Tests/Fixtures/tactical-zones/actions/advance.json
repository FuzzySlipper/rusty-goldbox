{
  "type": "action",
  "id": "advance",
  "name": "Advance",
  "cost": {
    "standard": 1
  },
  "target": "enemy",
  "valid_target": "combat.distance > 1",
  "prefer": "0 - combat.distance",
  "always": [
    {
      "op": "move",
      "distance": "floor(self.speed / 5)",
      "within": "1"
    }
  ]
}
